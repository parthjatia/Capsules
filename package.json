{
  "name": "@pyscoparth/capsules",
  "version": "0.0.0",
  "description": "A Git-stored, nested record of what each part of an AI-built app is meant to do, and a guard that stops agents from quietly breaking it. Makes no AI or network calls.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "capsules": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parthjatia/Capsules.git"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && vitest run",
    "spec:sync": "node scripts/sync-spec.mjs",
    "spec:check": "node scripts/sync-spec.mjs --check"
  },
  "dependencies": {
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  }
}
