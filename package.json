{
  "name": "@pyscoparth/capsules",
  "version": "0.1.0-rc.3",
  "description": "A Git-stored, nested record of what each part of an AI-built app is meant to do, and a guard that stops agents from quietly breaking it. Makes no AI or network calls.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "capsules": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parthjatia/Capsules.git"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && vitest run",
    "spec:sync": "node scripts/sync-spec.mjs",
    "spec:check": "node scripts/sync-spec.mjs --check",
    "pack:partner": "node scripts/pack-partner.mjs",
    "try:partner": "node scripts/try-partner-install.mjs"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "picomatch": "^4.0.7",
    "remark-frontmatter": "^5.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.5",
    "@types/picomatch": "^4.0.3",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  }
}
